# BasicPublicPowerFlow

main: kit: flow: BasicPublicPowerFlow:
{
  entity: "public_power",
  kind: "basic",
  name: "BasicPublicPowerFlow",
  step: [
    {
      i: {
        ref: "public_power_ref01",
        srcdatavar: "public_power_ref01_data",
        suffix: "_dt0"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-public_power_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicPublicPowerFlow"
}